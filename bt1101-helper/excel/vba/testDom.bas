Attribute VB_Name = "testDom"
Option Explicit

' Differential tests for the VBA DOM against pdf/src/minidom.js (cases generated by
' excel/test/dom-test.js), plus self-checks for timers and the mutation hook.

Private mVars As clsDomHash
Private mBehave(1 To 8) As String
Private mLog As String
Private mMutLog As String

' ================================================================ entry point

Public Function RunCases(ByVal caseFile As String) As String
    Dim content As String, records() As String, f() As String, i As Long, kind As String
    Dim total As Long, bad As Long, report As String, shown As Long, got As String, want As String
    Dim t0 As Double, tParse As Double, parseTimes As String, counts As String, kinds As String, k As Long
    Dim kTotal(0 To 5) As Long, kBad(0 To 5) As Long, kIndex As Long, scenarioStarted As Boolean, timing As String
    content = ReadUtf8(caseFile)
    records = Split(content, ChrW$(30))
    Set mVars = New clsDomHash
    kinds = "BQECMS"
    For i = 0 To UBound(records)
        f = Split(records(i), ChrW$(31))
        kind = f(0)
        kIndex = InStr(1, kinds, kind) - 1
        If kind = "S" And Not scenarioStarted Then
            scenarioStarted = True
            timing = Benchmarks()
        End If
        On Error Resume Next
        got = ""
        Select Case kind
        Case "B"
            t0 = Timer
            modDom.LoadDocument f(1)
            tParse = Timer - t0
            parseTimes = parseTimes & "parse body (" & Format$(Len(f(1)) / 1024, "0") & " KB): " & Format$(tParse * 1000, "0") & " ms" & vbLf
            got = modDom.Body.InnerHtml
            want = f(2)
            If got = want Then
                got = CStr(modDom.QA("*").Count)
                want = f(3)
            End If
        Case "Q"
            got = Paths(modDom.QA(f(1)))
            want = f(2)
            If got = want And Err.Number = 0 Then
                got = NodePath(modDom.Q(f(1)))
                want = FirstPath(f(2))
            End If
        Case "E"
            got = Paths(NodeAt(f(1)).QuerySelectorAll(f(2)))
            want = f(3)
        Case "C"
            got = NodePath(NodeAt(f(1)).Closest(f(2)))
            want = f(3)
        Case "M"
            got = Flag(NodeAt(f(1)).Matches(f(2)))
            want = f(3)
        Case "S"
            got = RunOp(f(1), f(2), f(3), f(4), f(5))
            want = f(6)
        End Select
        If Err.Number <> 0 Then got = "ERR " & Err.Number & ": " & Err.Description: If kind = "S" Then got = "ERR"
        Err.Clear
        On Error GoTo 0
        total = total + 1
        kTotal(kIndex) = kTotal(kIndex) + 1
        If got <> want Then
            bad = bad + 1
            kBad(kIndex) = kBad(kIndex) + 1
            If shown < 40 Then
                shown = shown + 1
                report = report & "MISMATCH #" & i & " [" & Esc(Join(Slice(f, 0, IIf(kind = "S", 6, 2)), " | "), 300) & "]" & vbLf & _
                    "   got:  " & Esc(got, 600) & vbLf & "   want: " & Esc(want, 600) & vbLf
            End If
        End If
    Next
    For k = 0 To 5
        counts = counts & Mid$(kinds, k + 1, 1) & "=" & (kTotal(k) - kBad(k)) & "/" & kTotal(k) & " "
    Next
    RunCases = "DOM differential: " & (total - bad) & "/" & total & " passed, " & bad & " mismatches (" & Trim$(counts) & ")" & vbLf & _
        parseTimes & timing & SelfChecks() & report
End Function

Private Function Slice(ByRef f() As String, ByVal a As Long, ByVal n As Long) As Variant
    Dim out() As String, i As Long
    If a + n - 1 > UBound(f) Then n = UBound(f) - a + 1
    ReDim out(0 To n - 1)
    For i = 0 To n - 1
        out(i) = f(a + i)
    Next
    Slice = out
End Function

' ================================================================ benchmarks

Private Function Benchmarks() As String
    Dim ids As clsList, i As Long, j As Long, t0 As Double, dt As Double, out As String, n As Long, node As clsNode
    Dim reps As Long, list As clsList, idText() As String
    Set list = modDom.QA("[id]")
    n = list.Count
    If n > 100 Then n = 100
    ReDim idText(0 To n - 1)
    For i = 0 To n - 1
        Set node = list.Item(i)
        idText(i) = node.Id
    Next
    reps = 20
    t0 = Timer
    For j = 1 To reps
        For i = 0 To n - 1
            Set node = modDom.ById(idText(i))
        Next
    Next
    dt = (Timer - t0) / reps
    out = out & "100 x ById: " & Format$(dt * 1000, "0.00") & " ms" & vbLf
    reps = 20
    t0 = Timer
    For j = 1 To reps
        Set list = modDom.QA(".panel")
    Next
    dt = (Timer - t0) / reps
    out = out & "QA(.panel): " & Format$(dt * 1000, "0.00") & " ms (" & list.Count & " matches)" & vbLf
    t0 = Timer
    For j = 1 To reps
        Set list = modDom.QA("#tutorialList .operation[data-id]")
    Next
    dt = (Timer - t0) / reps
    out = out & "QA(#tutorialList .operation[data-id]): " & Format$(dt * 1000, "0.00") & " ms (" & list.Count & " matches)" & vbLf
    t0 = Timer
    For j = 1 To reps
        Set list = modDom.QA("*")
    Next
    dt = (Timer - t0) / reps
    out = out & "QA(*): " & Format$(dt * 1000, "0.00") & " ms (" & list.Count & " elements)" & vbLf
    t0 = Timer
    For j = 1 To reps
        Set node = modDom.Q("#doesNotExist")
    Next
    dt = (Timer - t0) / reps
    out = out & "Q(#missing): " & Format$(dt * 1000, "0.00") & " ms" & vbLf
    t0 = Timer
    Dim html As String
    For j = 1 To 5
        html = modDom.Body.InnerHtml
    Next
    dt = (Timer - t0) / 5
    out = out & "body.InnerHtml get: " & Format$(dt * 1000, "0.0") & " ms (" & Len(html) & " chars)" & vbLf
    Benchmarks = out
End Function

' ================================================================ helpers

Private Function Flag(ByVal value As Boolean) As String
    If value Then Flag = "1" Else Flag = "0"
End Function

Private Function FirstPath(ByVal list As String) As String
    Dim at As Long
    If Len(list) = 0 Then FirstPath = "null": Exit Function
    at = InStr(1, list, ",")
    If at = 0 Then FirstPath = list Else FirstPath = Left$(list, at - 1)
End Function

Public Function NodePath(ByVal node As clsNode) As String
    Dim s As String, first As Boolean
    If node Is Nothing Then NodePath = "null": Exit Function
    If node Is modDom.Win Then NodePath = "win": Exit Function
    If node.NodeType = 9 Then NodePath = "doc": Exit Function
    first = True
    Do While Not node.ParentNode Is Nothing
        If first Then s = CStr(node.IndexInParent) Else s = node.IndexInParent & "." & s
        first = False
        Set node = node.ParentNode
    Loop
    If node.NodeType = 9 Then NodePath = s Else NodePath = "~" & s
End Function

Private Function Paths(ByVal list As clsList) As String
    Dim i As Long, s As String, node As clsNode
    For i = 0 To list.Count - 1
        Set node = list.Item(i)
        If i > 0 Then s = s & ","
        s = s & NodePath(node)
    Next
    Paths = s
End Function

Private Function NodeAt(ByVal p As String) As clsNode
    Dim parts() As String, i As Long, node As clsNode
    Set node = modDom.Doc
    If Len(p) > 0 Then
        parts = Split(p, ".")
        For i = 0 To UBound(parts)
            Set node = node.Kid(CLng(parts(i)))
        Next
    End If
    Set NodeAt = node
End Function

Private Function Esc(ByVal s As String, ByVal maxLen As Long) As String
    Dim i As Long, c As Long, out As String
    If Len(s) > maxLen Then s = Left$(s, maxLen) & "..."
    For i = 1 To Len(s)
        c = AscW(Mid$(s, i, 1)) And &HFFFF&
        If c = 10 Then
            out = out & "\n"
        ElseIf c < 32 Or c > 126 Then
            out = out & "\u" & Right$("000" & Hex$(c), 4)
        Else
            out = out & ChrW$(c)
        End If
    Next
    Esc = out
End Function

Public Function ReadUtf8(ByVal filePath As String) As String
    Dim f As Integer, n As Long, b() As Byte, out() As Byte, i As Long, o As Long, c As Long, cp As Long, s As String
    f = FreeFile
    Open filePath For Binary Access Read As #f
    n = LOF(f)
    If n = 0 Then Close #f: Exit Function
    ReDim b(0 To n - 1)
    Get #f, , b
    Close #f
    ReDim out(0 To 2 * n + 1)
    i = 0
    If n >= 3 Then
        If b(0) = &HEF And b(1) = &HBB And b(2) = &HBF Then i = 3
    End If
    Do While i < n
        c = b(i)
        If c < &H80 Then
            cp = c: i = i + 1
        ElseIf c < &HE0 Then
            cp = (c And &H1F) * 64& + (b(i + 1) And &H3F): i = i + 2
        ElseIf c < &HF0 Then
            cp = (c And &HF) * 4096& + (b(i + 1) And &H3F) * 64& + (b(i + 2) And &H3F): i = i + 3
        Else
            cp = (c And 7) * 262144 + (b(i + 1) And &H3F) * 4096& + (b(i + 2) And &H3F) * 64& + (b(i + 3) And &H3F): i = i + 4
        End If
        If cp >= &H10000 Then
            cp = cp - &H10000
            WriteUnit out, o, &HD800& + (cp \ 1024)
            WriteUnit out, o, &HDC00& + (cp Mod 1024)
        Else
            WriteUnit out, o, cp
        End If
    Loop
    If o = 0 Then Exit Function
    ReDim Preserve out(0 To o - 1)
    s = out
    ReadUtf8 = s
End Function

Private Sub WriteUnit(ByRef out() As Byte, ByRef o As Long, ByVal unit As Long)
    out(o) = unit And &HFF
    out(o + 1) = (unit \ 256) And &HFF
    o = o + 2
End Sub

' ================================================================ scenario interpreter

Private Function Ref(ByVal text As String) As clsNode
    Dim found As Boolean
    If text = "doc" Then Set Ref = modDom.Doc: Exit Function
    If text = "win" Then Set Ref = modDom.Win: Exit Function
    If text = "body" Then Set Ref = modDom.Body: Exit Function
    If Left$(text, 1) = "$" Then
        If mVars.Exists(Mid$(text, 2)) Then Set Ref = mVars.Lookup(Mid$(text, 2), found)
        Exit Function
    End If
    If Left$(text, 1) = "@" Then Set Ref = NodeAt(Mid$(text, 2)): Exit Function
    Set Ref = modDom.Q(text)
End Function

Private Sub SetVar(ByVal name As String, ByVal node As clsNode)
    mVars.Store name, node
End Sub

Private Function Kids(ByVal node As clsNode) As String
    Dim i As Long, s As String, kid As clsNode
    For i = 0 To node.KidCount - 1
        Set kid = node.Kid(i)
        If i > 0 Then s = s & "|"
        s = s & kid.NodeType
        If kid.NodeType = 3 Then
            s = s & "'" & kid.Data & "'"
        ElseIf kid.NodeType = 1 Then
            s = s & kid.LocalName
        End If
    Next
    Kids = s
End Function

Private Function OptsText(ByVal sel As clsNode) As String
    Dim opts As clsList, i As Long, s As String, opt As clsNode
    Set opts = sel.Options
    For i = 0 To opts.Count - 1
        Set opt = opts.Item(i)
        If i > 0 Then s = s & "|"
        s = s & opt.Value
        If opt.Selected Then s = s & "*"
    Next
    OptsText = s
End Function

Private Function RunOp(ByVal op As String, ByVal a As String, ByVal b As String, ByVal c As String, ByVal d As String) As String
    Dim el As clsNode, node As clsNode, v As Variant, parts() As String, opt As clsNode
    Select Case op
    Case "let": Set node = Ref(b): SetVar a, node: RunOp = NodePath(node)
    Case "create": SetVar a, modDom.CreateElement(b)
    Case "textnode": SetVar a, modDom.CreateTextNode(b)
    Case "frag": SetVar a, modDom.CreateFragment()
    Case "parse": Set node = modDom.ParseFragment(b): SetVar a, node: RunOp = CStr(node.KidCount)
    Case "sethtml": Set el = Ref(a): el.InnerHtml = b: RunOp = el.InnerHtml
    Case "html": RunOp = Ref(a).InnerHtml
    Case "outer": RunOp = Ref(a).OuterHtml
    Case "setouter": Ref(a).OuterHtml = b
    Case "adj": Ref(a).InsertAdjacentHtml b, c
    Case "adjel": Ref(a).InsertAdjacentElement b, Ref(c)
    Case "settext": Ref(a).TextContent = b
    Case "gettext": RunOp = Ref(a).TextContent
    Case "setval": Ref(a).Value = b
    Case "val": RunOp = Ref(a).Value
    Case "defval": RunOp = Ref(a).DefaultValue
    Case "setchecked": Ref(a).Checked = (b = "1")
    Case "checked": RunOp = Flag(Ref(a).Checked)
    Case "setselidx": Ref(a).SelectedIndex = CLng(b)
    Case "selidx": RunOp = CStr(Ref(a).SelectedIndex)
    Case "opts": RunOp = OptsText(Ref(a))
    Case "optsel": Set opt = Ref(a).Options.Item(CLng(b)): RunOp = Flag(opt.Selected)
    Case "setoptsel": Set opt = Ref(a).Options.Item(CLng(b)): opt.Selected = (c = "1")
    Case "opttext": RunOp = Ref(a).Text
    Case "click": Ref(a).Click
    Case "listen": Ref(a).AddEventListener b, "testDom." & c, InStr(1, d, "c") > 0, InStr(1, d, "o") > 0
    Case "unlisten": Ref(a).RemoveEventListener b, "testDom." & c, (d = "c")
    Case "behave": mBehave(CLng(Mid$(a, 2))) = b
    Case "dispatch": RunOp = Flag(Ref(a).DispatchEvent(modDom.NewEvent(b, c = "1", d = "1")))
    Case "log": RunOp = mLog: mLog = ""
    Case "attr"
        v = Ref(a).GetAttribute(b)
        If IsNull(v) Then RunOp = ChrW$(0) & "null" Else RunOp = v
    Case "hasattr": RunOp = Flag(Ref(a).HasAttribute(b))
    Case "setattr": Ref(a).SetAttribute b, c
    Case "rmattr": Ref(a).RemoveAttribute b
    Case "toggleattr"
        If c = "" Then RunOp = Flag(Ref(a).ToggleAttribute(b)) Else RunOp = Flag(Ref(a).ToggleAttribute(b, c = "1"))
    Case "attrs": RunOp = Ref(a).AttributeNames.Join(",")
    Case "dget"
        v = Ref(a).DataGet(b)
        If IsNull(v) Then RunOp = ChrW$(0) & "null" Else RunOp = v
    Case "dset": Ref(a).DataSet b, c
    Case "ddel": Ref(a).DataRemove b
    Case "addcls"
        parts = Split(b, " ")
        If UBound(parts) = 0 Then Ref(a).AddClass parts(0) Else Ref(a).AddClass parts(0), parts(1)
    Case "rmcls"
        parts = Split(b, " ")
        If UBound(parts) = 0 Then Ref(a).RemoveClass parts(0) Else Ref(a).RemoveClass parts(0), parts(1)
    Case "togglecls"
        If c = "" Then RunOp = Flag(Ref(a).ToggleClass(b)) Else RunOp = Flag(Ref(a).ToggleClass(b, c = "1"))
    Case "replcls": RunOp = Flag(Ref(a).ReplaceClass(b, c))
    Case "hascls": RunOp = Flag(Ref(a).HasClass(b))
    Case "cls": RunOp = Ref(a).ClassName
    Case "qsa": RunOp = Paths(Ref(a).QuerySelectorAll(b))
    Case "qs": RunOp = NodePath(Ref(a).QuerySelector(b))
    Case "closest": RunOp = NodePath(Ref(a).Closest(b))
    Case "matches": RunOp = Flag(Ref(a).Matches(b))
    Case "append": Ref(a).Append Ref(b)
    Case "appendtext": Ref(a).Append b
    Case "appendmix": Ref(a).Append b, Ref(c), d
    Case "prepend": Ref(a).Prepend Ref(b)
    Case "before": Ref(a).Before Ref(b)
    Case "after": Ref(a).After Ref(b)
    Case "replacewith": Ref(a).ReplaceWith Ref(b)
    Case "replacechildren": Ref(a).ReplaceChildren Ref(b)
    Case "remove": Ref(a).Remove
    Case "appendchild": Ref(a).AppendChild Ref(b)
    Case "insertbefore"
        If b = c Then Ref(a).InsertBefore Ref(b), Nothing Else Ref(a).InsertBefore Ref(b), Ref(c)
    Case "removechild": Ref(a).RemoveChild Ref(b)
    Case "clone"
        Set node = Ref(b).CloneNode(c = "1")
        SetVar a, node
        If node.NodeType = 1 Then RunOp = node.OuterHtml Else RunOp = CStr(node.KidCount)
    Case "focus": Ref(a).Focus
    Case "blur": Ref(a).Blur
    Case "active": RunOp = NodePath(modDom.ActiveElement)
    Case "kids": RunOp = Kids(Ref(a))
    Case "type": RunOp = Ref(a).TypeName
    Case "disabled": RunOp = Flag(Ref(a).Disabled)
    Case "setdisabled": Ref(a).Disabled = (b = "1")
    Case "hidden": RunOp = Flag(Ref(a).Hidden)
    Case "sethidden": Ref(a).Hidden = (b = "1")
    Case "byid": RunOp = NodePath(modDom.ById(a))
    Case "contains": RunOp = Flag(Ref(a).Contains(Ref(b)))
    Case "open": RunOp = Flag(Ref(a).IsOpen)
    Case "setopen": Ref(a).IsOpen = (b = "1")
    Case "connected": RunOp = Flag(Ref(a).IsConnected)
    Case "path": RunOp = NodePath(Ref(a))
    Case "parent": RunOp = NodePath(Ref(a).ParentNode)
    Case "next": RunOp = NodePath(Ref(a).NextSibling)
    Case "prev": RunOp = NodePath(Ref(a).PreviousSibling)
    Case "nextel": RunOp = NodePath(Ref(a).NextElementSibling)
    Case "prevel": RunOp = NodePath(Ref(a).PreviousElementSibling)
    Case "firstel": RunOp = NodePath(Ref(a).FirstElementChild)
    Case "lastel": RunOp = NodePath(Ref(a).LastElementChild)
    Case "children": RunOp = Paths(Ref(a).Children)
    Case "tag": RunOp = Ref(a).TagName
    Case "setid": Ref(a).Id = b
    Case "id": RunOp = Ref(a).Id
    Case "settitle": Ref(a).Title = b
    Case "title": RunOp = Ref(a).Title
    Case "placeholder": RunOp = Ref(a).Placeholder
    Case "htmlfor": RunOp = Ref(a).HtmlFor
    Case "data": RunOp = Ref(a).Data
    Case "replacechild": Ref(a).ReplaceChild Ref(b), Ref(c)
    Case "index": RunOp = CStr(Ref(a).Index)
    Case "control": RunOp = NodePath(Ref(a).LabelControl)
    Case "byidfrag": RunOp = NodePath(Ref(a).GetElementById(b))
    Case Else: Err.Raise vbObjectError + 900, "testDom", "Unknown op " & op
    End Select
End Function

' ================================================================ event handlers

Private Sub HandleEvt(ByVal idx As Long, ByVal evt As clsEvent)
    Dim line As String, t As clsNode
    Set t = evt.Target
    line = "H" & idx & ":" & evt.EventType & "@" & NodePath(evt.CurrentTarget) & ":" & evt.EventPhase & ":" & NodePath(t)
    If Not t Is Nothing Then
        If t.LocalName = "input" Then line = line & ":c" & Flag(t.Checked)
    End If
    If Len(mLog) > 0 Then mLog = mLog & " "
    mLog = mLog & line
    Select Case mBehave(idx)
    Case "stop": evt.StopPropagation
    Case "stopnow": evt.StopImmediatePropagation
    Case "prevent": evt.PreventDefault
    End Select
End Sub

Public Sub H1(ByVal evt As clsEvent): HandleEvt 1, evt: End Sub
Public Sub H2(ByVal evt As clsEvent): HandleEvt 2, evt: End Sub
Public Sub H3(ByVal evt As clsEvent): HandleEvt 3, evt: End Sub
Public Sub H4(ByVal evt As clsEvent): HandleEvt 4, evt: End Sub
Public Sub H5(ByVal evt As clsEvent): HandleEvt 5, evt: End Sub
Public Sub H6(ByVal evt As clsEvent): HandleEvt 6, evt: End Sub
Public Sub H7(ByVal evt As clsEvent): HandleEvt 7, evt: End Sub
Public Sub H8(ByVal evt As clsEvent): HandleEvt 8, evt: End Sub

' ================================================================ timers and mutation hook

Public Sub T1(ByVal arg As Variant)
    mLog = mLog & "T1(" & arg & ")@" & modDom.ClockNow & " "
    If arg = "spawn" Then
        modDom.QueueMicrotask "testDom.T2", "micro"
        modDom.SetTimeout "testDom.T1", 0, "child"
    End If
End Sub

Public Sub T2(ByVal arg As Variant)
    mLog = mLog & "T2(" & arg & ")@" & modDom.ClockNow & " "
End Sub

Public Sub T3()
    mLog = mLog & "T3@" & modDom.ClockNow & " "
End Sub

Public Sub OnMut(ByVal parent As clsNode, ByVal added As clsList)
    Dim i As Long, node As clsNode
    mMutLog = mMutLog & NodePath(parent) & "+"
    For i = 0 To added.Count - 1
        Set node = added.Item(i)
        mMutLog = mMutLog & node.NodeName
        If i < added.Count - 1 Then mMutLog = mMutLog & ","
    Next
    mMutLog = mMutLog & " "
End Sub

Private Sub Expect(ByRef out As String, ByVal label As String, ByVal got As String, ByVal want As String)
    If got = want Then
        out = out & "ok " & label & vbLf
    Else
        out = out & "FAIL " & label & vbLf & "   got:  " & Esc(got, 400) & vbLf & "   want: " & Esc(want, 400) & vbLf
    End If
End Sub

Private Function SelfChecks() As String
    Dim out As String, t0 As Double, id1 As Long, id2 As Long, el As clsNode, frag As clsNode, v0 As Long, v1 As Long
    Dim w As clsNode, nv As Long
    ' --- timers
    mLog = ""
    t0 = modDom.ClockNow
    modDom.SetTimeout "testDom.T1", 1000, "late"
    modDom.SetTimeout "testDom.T1", 10, "b"
    modDom.SetTimeout "testDom.T1", 10, "spawn"
    id1 = modDom.SetTimeout("testDom.T1", 5, "cleared")
    modDom.RequestAnimationFrame "testDom.T3"
    modDom.QueueMicrotask "testDom.T2", "first"
    modDom.ClearTimeout id1
    modDom.Settle 700
    Expect out, "timers settle", mLog, "T2(first)@" & t0 & " T1(b)@" & (t0 + 10) & " T1(spawn)@" & (t0 + 10) & " T2(micro)@" & (t0 + 10) & " T1(child)@" & (t0 + 10) & " T3@" & (t0 + 16) & " "
    Expect out, "next delay", CStr(modDom.NextTimerDelay), CStr(1000 - 16)
    mLog = ""
    modDom.AdvanceClock
    modDom.Settle 0
    Expect out, "advance+settle", mLog, "T1(late)@" & (t0 + 1000) & " "
    Expect out, "no timers", CStr(modDom.NextTimerDelay), "-1"
    ' --- mutation hook
    mMutLog = ""
    modDom.SetMutationHook "testDom.OnMut"
    Set w = modDom.Q("#w")
    Set el = modDom.CreateElement("section")
    el.InnerHtml = "<b>x</b>"
    w.AppendChild el
    w.InsertAdjacentHtml "beforeend", "<i>1</i>t"
    Set frag = modDom.ParseFragment("<u>u</u>")
    el.AppendChild frag
    Expect out, "hook queued (not yet delivered)", mMutLog, ""
    modDom.Settle 0
    Expect out, "hook delivered", mMutLog, NodePath(w) & "+SECTION " & NodePath(w) & "+I,#text " & NodePath(el) & "+U "
    modDom.SetMutationHook ""
    ' --- versions
    v0 = modDom.Version
    nv = el.Version
    el.SetAttribute "data-k", "1"
    Expect out, "node version bump", CStr(el.Version > nv), "True"
    Expect out, "global version bump", CStr(modDom.Version > v0), "True"
    ' --- keyboard event defaults
    Expect out, "key event", CStr(modDom.NewKeyEvent("keydown", "Enter").Bubbles) & modDom.NewKeyEvent("keydown", "a", True).Key, "Truea"
    ' --- style
    el.SetStyle "--sidebar-width", "240px"
    el.SetStyle "font-size", "12px"
    el.SetStyle "fontSize", "13px"
    Expect out, "style", el.GetStyle("font-size") & "|" & el.GetStyle("--sidebar-width") & "|" & el.StyleNames.Join(","), "13px|240px|--sidebar-width,font-size"
    Expect out, "escape", modDom.EscapeHtml("<a href='x'>&""</a>") & "|" & modDom.CssEscape("1a b-") & "|" & modDom.CssEscape("-"), "&lt;a href=&#39;x&#39;&gt;&amp;&quot;&lt;/a&gt;|\31 a\ b-|\-"
    ' --- reset breaks cycles
    modDom.ResetDocument
    Expect out, "reset", CStr(el.ParentNode Is Nothing) & CStr(modDom.Body.KidCount), "True0"
    SelfChecks = out
End Function
